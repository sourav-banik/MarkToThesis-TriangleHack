# Optional for the synthetic preview. Required together for real accounts and live commitment.
# These variables are server-only. Never prefix secrets with NEXT_PUBLIC_.
# Set the exact site origin. Use http://localhost:3000 during local development.
APP_URL=
SUPABASE_URL=
# Use the publishable (or legacy anon) key, never a service-role or secret key.
SUPABASE_PUBLISHABLE_KEY=
# Claude parser. Keep the key server-only. Model can be changed without UI changes.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
TWELVE_DATA_API_KEY=
FRED_API_KEY=
# Massive (Polygon) daily bars. Server-only.
MASSIVE_API_KEY=
# Optional dedicated Base Sepolia RPC; defaults to https://sepolia.base.org.
# Wallet signs testnet transactions in the browser. No private key is stored by this app.
BASE_SEPOLIA_RPC_URL=
# Trusted server write key. Prefer the current sb_secret_ key; the legacy name remains supported.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
